import pytest
import os
import re
from pathlib import Path


class TestReadmeDocumentation:
    """Test suite for README.md documentation file."""
    
    @pytest.fixture
    def readme_content(self):
        """Fixture to load README.md content."""
        readme_path = Path("README.md")
        if not readme_path.exists():
            pytest.skip("README.md not found")
        return readme_path.read_text(encoding="utf-8")
    
    def test_readme_file_exists(self):
        """Test that README.md file exists in the repository root."""
        assert Path("README.md").exists(), "README.md file should exist in project root"
    
    def test_readme_has_project_title(self, readme_content):
        """Test that README contains the project title."""
        assert "# 13-11-2025 Assignment Project" in readme_content, \
            "README should contain the project title"
    
    def test_readme_has_required_sections(self, readme_content):
        """Test that README contains all required documentation sections."""
        required_sections = [
            "## Table of Contents",
            "## Overview",
            "## Features",
            "## Tech Stack",
            "## Prerequisites",
            "## Installation",
            "## Usage",
            "## Project Structure",
            "## Troubleshooting",
            "## Contributing",
            "## License",
            "## Contact"
        ]
        
        for section in required_sections:
            assert section in readme_content, \
                f"README should contain section: {section}"
    
    def test_readme_has_badges(self, readme_content):
        """Test that README contains status badges for build, license, and version."""
        assert "[![License:" in readme_content, "README should contain license badge"
        assert "[![Build Status" in readme_content, "README should contain build status badge"
        assert "[![Version" in readme_content, "README should contain version badge"
    
    def test_readme_has_code_blocks(self, readme_content):
        """Test that README contains properly formatted code blocks."""
        # Check for bash code blocks for installation instructions
        assert "```bash" in readme_content, "README should contain bash code blocks"
        
        # Check for python code blocks for examples
        assert "```python" in readme_content, "README should contain python code blocks"
        
        # Verify code blocks are closed
        code_block_count = readme_content.count("```")
        assert code_block_count % 2 == 0, "All code blocks should be properly closed"
    
    def test_readme_has_repository_links(self, readme_content):
        """Test that README contains links to the repository and author."""
        assert "https://github.com/rahulmahasetha/13-11-2025_Assignment" in readme_content, \
            "README should contain repository URL"
        assert "[@rahulmahasetha]" in readme_content, \
            "README should contain GitHub username"
    
    def test_readme_has_installation_steps(self, readme_content):
        """Test that README contains step-by-step installation instructions."""
        assert "### Step 1: Clone the Repository" in readme_content
        assert "### Step 2: Install Dependencies" in readme_content
        assert "git clone" in readme_content, "README should contain git clone command"
    
    def test_readme_has_markdown_tables(self, readme_content):
        """Test that README contains properly formatted markdown tables."""
        # Check for table headers (| Column | Column |)
        table_pattern = r'\|[^\n]+\|\n\|[-:\s|]+\|'
        tables = re.findall(table_pattern, readme_content)
        assert len(tables) >= 2, "README should contain markdown tables for configuration and API docs"
    
    def test_readme_has_troubleshooting_section(self, readme_content):
        """Test that README contains troubleshooting documentation."""
        assert "### Common Issues" in readme_content
        assert "Dependency Installation Fails" in readme_content
        assert "Port Already in Use" in readme_content
    
    def test_readme_has_contributing_guidelines(self, readme_content):
        """Test that README contains contribution guidelines."""
        assert "1. Fork the repository" in readme_content
        assert "2. Create your feature branch" in readme_content
        assert "3. Commit your changes" in readme_content
        assert "4. Push to the branch" in readme_content
        assert "5. Open a Pull Request" in readme_content
    
    def test_readme_is_substantial(self, readme_content):
        """Test that README file contains substantial documentation (not empty/minimal)."""
        assert len(readme_content) > 2000, \
            "README should contain substantial documentation (at least 2000 characters)"
        
        # Check for minimum number of lines
        lines = readme_content.split('\n')
        assert len(lines) > 50, "README should have at least 50 lines of content"
    
    def test_readme_has_environment_variables_documentation(self, readme_content):
        """Test that README documents environment variables."""
        assert "## Configuration" in readme_content
        assert "`APP_ENV`" in readme_content
        assert "`DATABASE_URL`" in readme_content
        assert "`SECRET_KEY`" in readme_content
    
    def test_readme_has_author_info(self, readme_content):
        """Test that README contains author contact information."""
        assert "Rahul Mahasetha" in readme_content
        assert "## Contact" in readme_content


class TestReadmeIntegration:
    """Integration tests for README validation."""
    
    def test_readme_links_are_valid_format(self):
        """Test that all markdown links in README have valid format."""
        readme_path = Path("README.md")
        if not readme_path.exists():
            pytest.skip("README.md not found")
            
        content = readme_path.read_text(encoding="utf-8")
        
        # Find all markdown links [text](url)
        link_pattern = r'\[([^\]]+)\]\(([^\)]+)\)'
        links = re.findall(link_pattern, content)
        
        assert len(links) > 0, "README should contain markdown links"
        
        for text, url in links:
            # Skip anchor links
            if url.startswith('#'):
                continue
            # Check that URLs start with http or https or are relative paths
            assert url.startswith(('http://', 'https://', './', '../')) or url.endswith('.md'), \
                f"Link '{text}' has invalid URL format: {url}"
    
    def test_readme_images_have_alt_text(self):
        """Test that all images/badges in README have alt text."""
        readme_path = Path("README.md")
        if not readme_path.exists():
            pytest.skip("README.md not found")
            
        content = readme_path.read_text(encoding="utf-8")
        
        # Find all image tags ![alt](url)
        image_pattern = r'!\[([^\]]*)\]\([^\)]+\)'
        images = re.findall(image_pattern, content)
        
        for alt_text in images:
            assert len(alt_text) > 0, "All images should have alt text for accessibility"


if __name__ == "__main__":
    pytest.main([__file__, "-v"])